    "customer:names": "node scripts/generate-customer-identities.mjs",
    "customer:verify": "node scripts/verify-customer-config.mjs",
    "customer:build": "node scripts/build-customer.mjs",
    "customer:plan": "node scripts/provision-customer.mjs",
    "customer:provision": "node scripts/provision-customer.mjs --execute",
    "customer:accept": "node scripts/accept-customer.mjs",
    "audit:golden": "node scripts/audit-golden.mjs",
