{
  "name": "dream-memory-golden-template",
  "type": "module",
  "version": "1.0.0-golden.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
