    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.11.0",
    "heic-to": "1.5.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
