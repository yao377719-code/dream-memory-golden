        for (const { item, index } of anniversaries) {
          const card = document.createElement("div");
          const row = document.createElement("div");
          const title = document.createElement("input");
          const date = document.createElement("input");
          const showWrap = document.createElement("label");
          const show = document.createElement("input");
          const calendarText = document.createElement("input");
          const note = document.createElement("textarea");
          const remove = document.createElement("button");
          card.className = "anniversary-edit-card";
          row.className = "anniversary-row";
          title.type = "text";
          title.value = item.title || item.name || "";
          title.placeholder = "纪念日名称";
          title.setAttribute("data-anniversary-edit", "title");
          title.setAttribute("data-index", String(index));
          date.type = "date";
          date.value = item.date || "";
          date.setAttribute("data-anniversary-edit", "date");
          date.setAttribute("data-index", String(index));
          showWrap.className = "switch-row";
          showWrap.append(document.createTextNode("在日历标记"));
          show.type = "checkbox";
          show.checked = item.showOnCalendar !== false;
          show.setAttribute("data-anniversary-edit", "showOnCalendar");
          show.setAttribute("data-index", String(index));
          showWrap.append(show);
          calendarText.type = "text";
          calendarText.value = item.calendarText || "";
          calendarText.placeholder = "日历短标记";
          calendarText.setAttribute("data-anniversary-edit", "calendarText");
          calendarText.setAttribute("data-index", String(index));
          note.value = item.note || "";
          note.placeholder = "备注";
          note.setAttribute("data-anniversary-edit", "note");
          note.setAttribute("data-index", String(index));
          remove.className = "small-danger";
          remove.type = "button";
          remove.textContent = "删除这个纪念日";
          remove.setAttribute("data-remove-anniversary", String(index));
          row.append(title, date, showWrap, calendarText, note, remove);
          card.append(row);
          manager.append(card);
        }
      }

      function hydrateForm() {
        document.querySelectorAll("[name]").forEach((field) => {
          if (field.type === "checkbox") {
            field.checked = Boolean(getPath(field.name));
          } else {
            field.value = getPath(field.name);
          }
        });

        document.querySelectorAll("[data-preview]").forEach((image) => {
          const path = image.getAttribute("data-preview");
          image.src = getPath(path);
        });

        renderBatchPreview();
        renderCoverPreview();
        renderCategoryControls();
        renderStoryManager();
        renderStoryImagePreview();
        renderQuoteManager();
        renderAnniversaryManager();
        syncThemeControls();
      }

      async function loadCloudData(password) {
        cloudLoadFailure = "";
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 12000);
        try {
          const response = await fetch(cloudEndpoint, {
            headers: { "x-admin-password": password },
            signal: controller.signal,
          });
          if (response.status === 401) {
            cloudLoadFailure = "unauthorized";
            return false;
          }
          if (!response.ok) throw new Error(`后台数据读取失败（${response.status}）`);
          const result = await response.json();
          if (!result.ok) throw new Error(result.message || "后台数据读取失败");
          if (result.ok && result.data) {
            state = mergeStateWithDefaults(result.data);
            localStorage.setItem(storageKey, JSON.stringify(state));
            hydrateForm();
            showToast("已读取云端保存内容");
          }
          if (result.ok) rememberSavedTheme();
          return Boolean(result.ok);
        } catch (error) {
          cloudLoadFailure = "network";
          showToast("暂时没有读取到已保存内容，请稍后重试");
          setAdminInitState(
            "error",
            error?.name === "AbortError" ? "读取超时，请检查网络后重试。" : error?.message || "请检查网络后重试。",
          );
          return false;
        } finally {
          window.clearTimeout(timeout);
        }
      }

      function saveCloudData() {
        const snapshot = JSON.stringify(state);
        const save = async () => {
          const password = sessionStorage.getItem(passwordKey) || "";
          const response = await fetch(cloudEndpoint, {
            method: "POST",
            headers: {
              "content-type": "application/json",
              "x-admin-password": password,
            },
            body: snapshot,
          });
          const result = await response.json();
          if (!response.ok || !result.ok) {
            throw new Error(result.message || "保存失败");
          }
          rememberSavedTheme();
        };
        cloudSaveQueue = cloudSaveQueue.catch(() => {}).then(save);
        return cloudSaveQueue;
      }

      async function uploadImage(imageData, fileName) {
        const password = sessionStorage.getItem(passwordKey) || "";
        const response = await fetch("/api/admin-image", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            "x-admin-password": password,
          },
          body: JSON.stringify({ imageData, fileName }),
        });
        const responseText = await response.text();
        let result = null;
        try {
          result = JSON.parse(responseText);
        } catch {
          throw new Error(response.ok ? "服务器返回了无法识别的上传结果，请重试" : `上传请求失败（HTTP ${response.status}）`);
        }
        if (!response.ok || !result.ok) {
          throw new Error(result.message || `图片上传失败（HTTP ${response.status}）`);
        }
        return result.image;
      }

      function getUploadErrorMessage(error, fallback = "图片处理失败，请重新选择后再试") {
        return error instanceof Error && error.message ? error.message : fallback;
      }

      async function isHeicFile(file) {
        const type = String(file.type || "").toLowerCase();
        const name = String(file.name || "").toLowerCase();
        if (["image/heic", "image/heif", "image/heic-sequence", "image/heif-sequence"].includes(type)) return true;
        if (/\.(heic|heif)$/.test(name)) return true;
        try {
          const header = new Uint8Array(await file.slice(0, 32).arrayBuffer());
          const signature = String.fromCharCode(...header);
          return /ftyp(?:heic|heix|hevc|hevx|heim|heis|mif1|msf1)/.test(signature);
        } catch {
          return false;
        }
      }

      async function normalizeImageFile(file) {
        if (!(await isHeicFile(file))) return file;
        showToast("正在转换手机 HEIC/HEIF 图片，请稍候...");
        try {
          const { heicTo, isHeic } = await import("heic-to/csp");
          if (!(await isHeic(file))) throw new Error("文件内容不是有效的 HEIC/HEIF 图片");
          return await heicTo({ blob: file, type: "image/jpeg", quality: 0.9 });
        } catch (error) {
          throw new Error(`HEIC/HEIF 转换失败：${getUploadErrorMessage(error, "图片内容可能已损坏")}`);
        }
      }

      function readBlobAsDataUrl(blob) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.addEventListener("error", () => reject(new Error("无法读取处理后的图片数据")));
          reader.addEventListener("load", () => resolve(reader.result));
          reader.readAsDataURL(blob);
        });
      }

      const directUploadImageTypes = new Set(["image/jpeg", "image/png", "image/webp"]);
      const maxUploadImageBytes = 6 * 1024 * 1024;
      const targetCompressedImageBytes = Math.floor(5.75 * 1024 * 1024);

      async function compressImage(file, maxSize = 1200, quality = 0.82, preserveOriginal = false) {
        const source = await normalizeImageFile(file);
        if (preserveOriginal && directUploadImageTypes.has(String(source.type || "").toLowerCase()) && source.size <= maxUploadImageBytes) {
          return await readBlobAsDataUrl(source);
        }
        const objectUrl = URL.createObjectURL(source);
        try {
          const image = await new Promise((resolve, reject) => {
            const img = new Image();
            img.addEventListener("error", () => reject(new Error("浏览器无法识别这张图片，文件可能已损坏或格式不受支持")));
            img.addEventListener("load", () => resolve(img));
            img.src = objectUrl;
          });

          if (!image.naturalWidth || !image.naturalHeight) throw new Error("图片尺寸无效，无法上传");
          const maxPixelRatio = Math.sqrt((16 * 1024 * 1024) / (image.naturalWidth * image.naturalHeight));
          const ratio = Math.min(1, maxSize / Math.max(image.naturalWidth, image.naturalHeight), maxPixelRatio);
          const canvas = document.createElement("canvas");
          canvas.width = Math.max(1, Math.round(image.naturalWidth * ratio));
          canvas.height = Math.max(1, Math.round(image.naturalHeight * ratio));
          const drawSource = () => {
            const context = canvas.getContext("2d");
            if (!context) throw new Error("当前浏览器无法处理图片，请更新浏览器后重试");
            context.imageSmoothingEnabled = true;
            context.imageSmoothingQuality = "high";
            context.drawImage(image, 0, 0, canvas.width, canvas.height);
          };
          const encodeJpeg = (outputQuality) => new Promise((resolve, reject) => {
            canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error("图片压缩失败，请重新选择后再试")), "image/jpeg", outputQuality);
          });
          drawSource();
          let outputQuality = quality;
          let output = await encodeJpeg(outputQuality);
          if (preserveOriginal) {
            while (output.size > targetCompressedImageBytes && outputQuality > 0.7) {
              outputQuality = Math.max(0.7, outputQuality - 0.07);
              output = await encodeJpeg(outputQuality);
            }
            for (let attempt = 0; output.size > targetCompressedImageBytes && attempt < 4; attempt += 1) {
              const scale = Math.min(0.9, Math.sqrt(targetCompressedImageBytes / output.size) * 0.92);
              canvas.width = Math.max(1, Math.round(canvas.width * scale));
              canvas.height = Math.max(1, Math.round(canvas.height * scale));
              drawSource();
              output = await encodeJpeg(Math.max(0.72, outputQuality));
            }
            if (output.size > maxUploadImageBytes) throw new Error("图片处理后仍超过 6MB，请裁剪后重新上传");
          }
          return await readBlobAsDataUrl(output);
        } finally {
          URL.revokeObjectURL(objectUrl);
        }
      }

      async function uploadSelectedFiles(files, options) {
        const selected = Number.isFinite(options.limit) ? files.slice(0, options.limit) : files;
        const failures = [];
        const uploaded = [];
        let successCount = 0;
        for (const [index, file] of selected.entries()) {
          const progressText = `正在处理第 ${index + 1}/${selected.length} 张：${file.name || "未命名图片"}`;
          showToast(progressText);
          options.onProgress?.(progressText, index + 1, selected.length);
          try {
            const imageData = await compressImage(file, options.maxSize, options.quality, options.preserveOriginal === true);
            const imageUrl = await uploadImage(imageData, file.name || `image-${index + 1}.jpg`);
            await options.onUploaded(imageUrl, file);
            uploaded.push({ imageUrl, file });
            successCount += 1;
          } catch (error) {
            failures.push({ fileName: file.name || `第 ${index + 1} 张`, message: getUploadErrorMessage(error) });
          }
        }
        return { successCount, failures, selectedCount: selected.length, uploaded };
      }

      function getUploadSummary(successText, result) {
        if (result.failures.length === 0) return successText;
        const first = result.failures[0];
        const remaining = result.failures.length > 1 ? `；另有 ${result.failures.length - 1} 张失败` : "";
        return `${result.successCount} 张成功，${result.failures.length} 张失败：${first.fileName}（${first.message}）${remaining}。失败图片可重新选择上传。`;
      }

      function renderBatchPreview() {
        const preview = document.querySelector("[data-batch-preview]");
        if (!preview) return;
        preview.textContent = "";
        const cloudImages = normalizeGalleryDraft(state.galleryDraft).images;
        const summary = document.querySelector("[data-gallery-count-summary]");
        if (summary) summary.textContent = `共 ${defaultGalleryItems.length + cloudImages.length} 张｜内置 ${defaultGalleryItems.length} 张｜云端 ${cloudImages.length} 张`;

        function appendCard(item, source, index = -1) {
          const figure = document.createElement("figure");
          const image = document.createElement("img");
          const caption = document.createElement("figcaption");
          const meta = document.createElement("div");
          const categoryBadge = document.createElement("span");
          const sourceBadge = document.createElement("span");
          figure.setAttribute("data-gallery-source", source);
          if (source === "cms") figure.classList.add("is-readonly");
          image.loading = "eager";
          image.decoding = "async";
          image.src = item.image;
          image.alt = item.title || item.category || "图片";
          caption.textContent = item.title || item.category || "未命名图片";
          meta.className = "batch-preview-meta";
          categoryBadge.className = "batch-category-badge";
          categoryBadge.textContent = item.category || getGalleryCategories().find((category) => category.key === item.categoryKey)?.title || "未分类";
          sourceBadge.className = `batch-source-badge is-${source}`;
          sourceBadge.textContent = source === "cms" ? "内置" : "云端";
          meta.append(categoryBadge, sourceBadge);
          figure.append(image, meta, caption);

          if (source === "cms") {
            preview.append(figure);
            return;
          }

          const controls = document.createElement("div");
          const category = document.createElement("select");
          const title = document.createElement("input");
          const description = document.createElement("input");
          const orderActions = document.createElement("div");
          const moveUp = document.createElement("button");
          const moveDown = document.createElement("button");
          const remove = document.createElement("button");
          controls.className = "batch-preview-controls";
          category.setAttribute("data-gallery-edit", "category");
          category.setAttribute("data-index", String(index));
          category.innerHTML = buildCategoryOptions(item.categoryKey || categoryLabelToKey(item.category));
          category.value = item.categoryKey || categoryLabelToKey(item.category);
          title.type = "text";
          title.placeholder = "标题可不填";
          title.value = item.title || "";
          title.setAttribute("data-gallery-edit", "title");
          title.setAttribute("data-index", String(index));
          description.type = "text";
          description.placeholder = "图片说明（可选）";
          description.value = item.caption || "";
          description.setAttribute("data-gallery-edit", "caption");
          description.setAttribute("data-index", String(index));
          remove.className = "small-danger";
          remove.type = "button";
          remove.textContent = "删除";
          remove.setAttribute("data-remove-gallery-image", String(index));
          orderActions.className = "category-order-actions";
          moveUp.className = "ghost-button";
          moveUp.type = "button";
          moveUp.textContent = "上移";
          moveUp.disabled = index === 0;
          moveUp.setAttribute("data-move-gallery-image", "up");
          moveUp.setAttribute("data-index", String(index));
          moveDown.className = "ghost-button";
          moveDown.type = "button";
          moveDown.textContent = "下移";
          moveDown.disabled = index === cloudImages.length - 1;
          moveDown.setAttribute("data-move-gallery-image", "down");
          moveDown.setAttribute("data-index", String(index));
          orderActions.append(moveUp, moveDown);
          controls.append(category, title, description, orderActions, remove);
          figure.append(controls);
          preview.append(figure);
        }

        defaultGalleryItems.forEach((item) => appendCard(item, "cms"));
        cloudImages.forEach((item, index) => appendCard(item, "cloud", index));
      }

