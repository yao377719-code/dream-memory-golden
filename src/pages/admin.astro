      function getAnniversaryItems() {
        state.anniversaryDraft ??= { items: [], deletedAnniversaryIds: [] };
        state.anniversaryDraft.items ??= [];
        state.anniversaryDraft.deletedAnniversaryIds ??= [];
        const deletedKeys = new Set(state.anniversaryDraft.deletedAnniversaryIds);
        const existingKeys = new Set(state.anniversaryDraft.items.map((item) => item.sourceId || item.id));
        for (const item of defaultAnniversaryItems) {
          const key = item.sourceId || item.id;
          if (!deletedKeys.has(key) && !existingKeys.has(key)) {
            state.anniversaryDraft.items.push({ ...item });
          }
        }
        return state.anniversaryDraft.items;
      }

      function renderAnniversaryManager() {
        const manager = document.querySelector("[data-anniversary-manager]");
        if (!manager) return;
        manager.textContent = "";
        const anniversaries = getAnniversaryItems()
          .map((item, index) => ({ item, index }))
          .sort((a, b) => String(a.item.date || "").localeCompare(String(b.item.date || "")));
        if (anniversaries.length === 0) {
