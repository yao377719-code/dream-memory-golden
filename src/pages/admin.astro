          const categories = ensureGalleryCategories();
          const index = Number(target.getAttribute("data-index"));
          const nextIndex = moveDirection === "up" ? index - 1 : index + 1;
          if (!categories[index] || !categories[nextIndex]) return;
          [categories[index], categories[nextIndex]] = [categories[nextIndex], categories[index]];
          categories.forEach((category, orderIndex) => {
            category.order = orderIndex + 1;
          });
          renderCategoryControls();
          renderBatchPreview();
          showToast("分类顺序已调整，记得保存");
          return;
        }
        const clearIndex = target?.getAttribute?.("data-clear-category-cover");
        if (clearIndex != null) {
          const category = ensureGalleryCategories()[Number(clearIndex)];
          if (!category) return;
          category.cover = "";
          const preview = document.querySelector(`[data-category-cover-preview="${clearIndex}"]`);
          if (preview) {
            preview.src = getCategoryCoverPreview(category);
            preview.style.objectPosition = "center";
          }
          showToast("已清除自定义封面，保存后会自动使用分类第一张照片");
          return;
