        const index = Number(indexValue);
        const category = categories[index];
        if (!category) return;
        const categoryImages = (state.galleryDraft?.images || []).filter((item) => item.categoryKey === category.key);
        if (categoryImages.length > 0) {
          const firstConfirmed = window.confirm(`分类“${category.title}”中有 ${categoryImages.length} 张图片。删除分类不会删除图片，图片会保留并标记为“未分类”。是否继续？`);
