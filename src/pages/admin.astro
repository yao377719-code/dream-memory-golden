        state.quotesDraft.items ??= [];
        state.quotesDraft.deletedQuoteIds ??= [];
        const deletedKeys = new Set(state.quotesDraft.deletedQuoteIds);
        const existingKeys = new Set(state.quotesDraft.items.map((item) => item.sourceId || item.id));
        for (const item of defaultQuoteItems) {
          const key = item.sourceId || item.id;
          if (!deletedKeys.has(key) && !existingKeys.has(key)) {
            state.quotesDraft.items.push({ ...item });
          }
