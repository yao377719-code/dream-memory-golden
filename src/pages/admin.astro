        if (!category || !file || !preview) return;
        const previousSrc = preview.getAttribute("src") || "/uploads/memory-placeholder.svg";
        const instantPreviewUrl = URL.createObjectURL(file);
        preview.src = instantPreviewUrl;
        target.disabled = true;
        showToast("分类封面已预览，正在上传并保存...");
        try {
          const imageData = await compressImage(file, 1200, 0.82);
          const imageUrl = await uploadImage(imageData, file.name);
          category.cover = imageUrl;
          preview.src = imageUrl;
          localStorage.setItem(storageKey, JSON.stringify(state));
          await saveCloudData();
          showToast("分类封面已上传并保存到云端");
        } catch (error) {
          preview.src = previousSrc;
          showToast(error.message || "分类封面上传失败，请重试");
