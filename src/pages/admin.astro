          content.value = item.content || "";
          content.placeholder = "语录内容";
          content.setAttribute("data-quote-edit", "content");
          content.setAttribute("data-index", String(index));
          mood.type = "text";
          mood.value = item.mood || "";
          mood.placeholder = "标签/心情";
          mood.setAttribute("data-quote-edit", "mood");
          mood.setAttribute("data-index", String(index));
          remove.className = "small-danger";
          remove.type = "button";
          remove.textContent = "删除这句";
          remove.setAttribute("data-remove-quote", String(index));
          row.append(content, mood, remove);
          card.append(row);
