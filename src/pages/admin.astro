---
import { getCollection } from "astro:content";
import { about, defaultGalleryCategories as blankGalleryCategories, isBlankCustomerMode, modules, profile } from "../data/siteDefaults";
import { themeMap, themeOptions } from "../data/themes";
import { editableTitlePaths } from "../data/editableTitles.mjs";

const customerId = import.meta.env.PUBLIC_CUSTOMER_ID;
const pagesProjectName = import.meta.env.PUBLIC_PAGES_PROJECT_NAME;
const defaultGalleryCategories = isBlankCustomerMode ? blankGalleryCategories.map((category) => ({ ...category })) : (await getCollection("galleryCategories"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((category) => ({
    key: category.data.key,
    title: category.data.title,
    cover: category.data.cover || "",
    coverPosition: category.data.coverPosition || "center",
    order: category.data.order,
  }));
const defaultGalleryItems = isBlankCustomerMode ? [] : (await getCollection("albums"))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .flatMap((entry) => {
    const categoryKey = entry.data.category || "daily";
    const category = defaultGalleryCategories.find((item) => item.key === categoryKey)?.title || categoryKey;
    const base = { sourceId: entry.id, categoryKey, category, title: entry.data.title || "", caption: entry.data.caption || "", readonly: true };
    const photos = [];
    if (entry.data.image) photos.push({ ...base, image: entry.data.image, id: `${entry.id}-single` });
    entry.data.images.forEach((image, index) => photos.push({ ...base, image, id: `${entry.id}-batch-${index}` }));
    entry.data.items.forEach((item, index) => photos.push({
      ...base,
      image: item.image,
      title: item.title || base.title,
      caption: item.caption || base.caption,
      id: `${entry.id}-item-${index}`,
    }));
    return photos;
  });
const defaultStoryItems = isBlankCustomerMode ? [] : (await getCollection("timeline"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((story) => ({
    id: `static-${story.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`,
    sourceId: story.id,
    date: story.data.date.toISOString().slice(0, 10),
    title: story.data.title,
    summary: story.data.summary ?? "",
    mood: story.data.mood ?? "",
    body: story.body ?? "",
    images: (story.data.images ?? []).map((item) => (typeof item === "string" ? item : item.image)).filter(Boolean),
  }));
const defaultQuoteItems = isBlankCustomerMode ? [] : (await getCollection("quotes"))
  .map((quote) => ({
    id: `static-${quote.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`,
    sourceId: quote.id,
    content: quote.data.content,
    mood: quote.data.mood ?? "",
  }));
const defaultAnniversaryItems = isBlankCustomerMode ? [] : (await getCollection("anniversaries"))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .map((item) => ({
    id: `static-${item.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`,
    sourceId: item.id,
    title: item.data.title ?? item.data.name ?? "",
    date: item.data.date.toISOString().slice(0, 10),
    kind: item.data.kind ?? "since",
    showOnCalendar: item.data.showOnCalendar ?? true,
    calendarText: item.data.calendarText ?? "",
    note: item.data.note ?? "",
    calendarColor: item.data.calendarColor ?? item.data.color ?? "gold",
  }));

const initialData = {
  profile,
  about,
  modules,
  galleryCategories: defaultGalleryCategories,
  defaultGalleryItems,
  defaultStoryItems,
  defaultQuoteItems,
  defaultAnniversaryItems,
  storyDraft: { items: defaultStoryItems, deletedStoryIds: [] },
  quotesDraft: { items: defaultQuoteItems, deletedQuoteIds: [] },
  anniversaryDraft: { items: defaultAnniversaryItems, deletedAnniversaryIds: [] },
  galleryDraft: { images: [] },
  customerMode: isBlankCustomerMode ? "blank" : "demo",
  customerId,
};
---

<!doctype html>
<html lang="zh-CN" data-admin-init="loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>网站管理后台</title>
    <script is:inline src="/theme-utils.js"></script>
    <style>
      :root {
        color-scheme: light;
        --ink: #27222a;
        --muted: #746977;
        --line: #e8dfe5;
        --paper: #fffafc;
        --accent: #8165b1;
        --accent-soft: #eee6fb;
        --accent-hover: #f6f1ff;
        --accent-strong: #694aa0;
        --accent-shadow: rgba(129, 101, 177, 0.24);
        --button-text: #ffffff;
        --site-bg: #f5f1f7;
        --site-bg-soft: #ebe4f0;
        font-family: "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--ink);
        background: linear-gradient(180deg, var(--site-bg), var(--site-bg-soft));
      }

      html[data-admin-init="loading"] body,
      html[data-admin-init="error"] body {
        background: #f3f4f6;
      }

      html[data-admin-init="loading"] [data-login],
      html[data-admin-init="loading"] [data-admin],
      html[data-admin-init="error"] [data-login],
      html[data-admin-init="error"] [data-admin] {
        visibility: hidden;
      }

      .admin-bootstrap {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #f3f4f6;
        color: #30323a;
      }

      .admin-bootstrap-card {
        display: grid;
        justify-items: center;
        gap: 12px;
        width: min(360px, 100%);
        padding: 24px;
        border: 1px solid #e1e3e8;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 16px 42px rgba(35, 38, 46, 0.08);
        text-align: center;
      }

      .admin-bootstrap-spinner {
        width: 30px;
        aspect-ratio: 1;
        border: 3px solid #d9dce3;
        border-top-color: #717684;
        border-radius: 50%;
        animation: admin-bootstrap-spin 0.8s linear infinite;
      }

      .admin-bootstrap p {
        margin: 0;
        color: #666b77;
        line-height: 1.65;
      }

      .admin-bootstrap button {
        min-height: 40px;
        padding: 8px 16px;
        border: 1px solid #cfd2da;
        border-radius: 8px;
        background: #fff;
        color: #30323a;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
      }

      html[data-admin-init="ready"] .admin-bootstrap {
        display: none;
      }

      html[data-admin-init="error"] .admin-bootstrap-spinner {
        display: none;
      }

      @keyframes admin-bootstrap-spin {
        to { transform: rotate(360deg); }
      }

      @media (prefers-reduced-motion: reduce) {
        .admin-bootstrap-spinner { animation: none; }
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      .admin-shell {
        width: min(860px, calc(100% - 28px));
        max-width: 860px;
        margin: 0 auto;
        padding: 24px 0 42px;
      }

      .admin-header,
      .admin-card,
      .login-card {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.88);
        box-shadow: 0 18px 42px rgba(92, 70, 82, 0.12);
      }

      .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
        padding: 16px;
      }

      .admin-header h1,
      .login-card h1 {
        margin: 0 0 6px;
        font-size: 24px;
      }

      .admin-header p,
      .login-card p,
      .hint {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .login-wrap {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 24px;
      }

      .login-card {
        width: min(420px, 100%);
        padding: 22px;
      }

      .login-card form,
      .admin-form,
      .field,
      .image-preview-field {
        display: grid;
        gap: 12px;
      }

      .field {
        gap: 7px;
      }

      label {
        font-weight: 800;
      }

      input,
      textarea,
      select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: #fff;
        color: var(--ink);
      }

      textarea {
        min-height: 108px;
        resize: vertical;
        line-height: 1.7;
      }

      .primary-button,
      .ghost-button,
      .ghost-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 850;
        text-decoration: none;
      }

      .primary-button {
        border: 0;
        background: var(--accent);
        color: var(--button-text);
      }

      .theme-customizer {
        display: grid;
        gap: 14px;
        margin: 14px 0;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: color-mix(in srgb, var(--paper) 88%, white);
      }

      .theme-customizer h3,
      .theme-customizer p {
        margin: 0;
      }

      .theme-inputs {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr);
        gap: 12px;
      }

      .color-picker-field input[type="color"] {
        width: 100%;
        min-height: 48px;
        padding: 4px;
        cursor: pointer;
      }

      .theme-preview {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--paper);
        color: var(--ink);
      }

      .theme-preview-swatch {
        min-width: 92px;
        min-height: 40px;
        display: inline-grid;
        place-items: center;
        border-radius: 9px;
        background: var(--accent);
        color: var(--button-text);
        font-weight: 850;
      }

      .theme-actions,
      .category-order-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .theme-error {
        min-height: 20px;
        color: #9b3048;
        font-size: 13px;
        font-weight: 750;
      }

      .module-guidance {
        margin: 14px 0 0;
        padding: 12px 14px;
        border-left: 4px solid var(--accent);
        border-radius: 8px;
        background: var(--accent-hover);
        color: var(--muted);
        line-height: 1.7;
      }

      .ghost-button,
      .ghost-link {
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
      }

      .header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }

      .admin-tabs {
        position: sticky;
        top: 0;
        z-index: 3;
        display: flex;
        overflow-x: auto;
        gap: 8px;
        padding: 8px 0;
        background: linear-gradient(180deg, var(--site-bg) 74%, rgba(255, 255, 255, 0));
      }

      .admin-tabs button {
        min-height: 42px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.78);
        color: var(--muted);
        cursor: pointer;
        font-weight: 800;
        text-align: left;
        white-space: nowrap;
        padding: 0 12px;
      }

      .admin-tabs button[aria-selected="true"] {
        border-color: var(--accent);
        background: var(--accent-soft);
        color: var(--accent);
      }

      .admin-card {
        display: none;
        overflow: hidden;
        padding: 18px;
      }

      .admin-card.is-active {
        display: block;
      }

      .admin-card h2 {
        margin: 0 0 14px;
        font-size: 21px;
      }

      .form-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .image-preview {
        width: 104px;
        aspect-ratio: 1;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #fff;
      }

      .image-preview.is-wide {
        width: 100%;
        aspect-ratio: 16 / 7;
      }

      .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .save-bar {
        position: sticky;
        bottom: 12px;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
        pointer-events: none;
      }

      .save-bar[hidden] {
        display: none;
      }

      .save-bar button {
        pointer-events: auto;
      }

      .toast {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 10;
        max-width: min(320px, calc(100% - 32px));
        padding: 12px 14px;
        border-radius: 10px;
        background: #27222a;
        color: #fff;
        box-shadow: 0 16px 38px rgba(0, 0, 0, 0.18);
      }

      [hidden] {
        display: none !important;
      }

      .batch-preview {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
        gap: 10px;
        margin-top: 10px;
        max-width: 100%;
        overflow: hidden;
      }

      .batch-preview figure {
        display: grid;
        min-width: 0;
        gap: 6px;
        margin: 0;
        padding: 8px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
      }

      .batch-preview img {
        width: 100%;
        max-width: 100%;
        height: 86px;
        aspect-ratio: 1;
        border-radius: 10px;
        object-fit: cover;
      }

      .batch-preview figcaption {
        overflow: hidden;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.35;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .batch-preview-controls {
        display: grid;
        gap: 6px;
      }

      .batch-preview-controls input,
      .batch-preview-controls select {
        min-height: 34px;
        padding: 6px 7px;
        font-size: 12px;
      }

      .small-danger {
        min-height: 32px;
        border: 1px solid var(--accent-soft);
        border-radius: 8px;
        background: var(--accent-hover);
        color: var(--accent-strong);
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
      }

      .category-manager {
        display: grid;
        gap: 8px;
        margin: 12px 0 16px;
      }

      .category-row {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr) 58px;
        align-items: center;
        gap: 8px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--paper);
      }

      .category-cover-editor { display: grid; gap: 6px; }
      .category-cover-editor img { width: 92px; height: 70px; border-radius: 9px; object-fit: cover; background: var(--accent-soft); }
      .category-cover-editor input { width: 92px; min-height: 0; font-size: 11px; }
      .category-fields { display: grid; gap: 7px; }

      .category-row input {
        min-height: 40px;
      }

      .category-row button {
        min-height: 40px;
        padding: 0 8px;
        border: 1px solid var(--accent-soft);
        border-radius: 8px;
        background: var(--accent-hover);
        color: var(--accent-strong);
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      @media (max-width: 560px) {
        .theme-inputs,
        .theme-preview { grid-template-columns: 1fr; }
        .category-row { grid-template-columns: 78px minmax(0, 1fr); }
        .category-cover-editor img { width: 78px; height: 64px; }
        .category-cover-editor input { width: 78px; }
        .category-row > .small-danger { grid-column: 1 / -1; }
      }

      .category-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .switch-list,
      .quote-manager,
      .anniversary-manager {
        display: grid;
        gap: 10px;
      }

      .switch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
      }

      .switch-row input {
        width: 22px;
        min-height: 22px;
        accent-color: var(--accent);
      }

      .quote-edit-card,
      .anniversary-edit-card {
        display: grid;
        gap: 8px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fff;
      }

      .quote-row,
      .anniversary-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 8px;
      }

      .quote-row textarea,
      .anniversary-row textarea {
        min-height: 76px;
      }

      @media (max-width: 720px) {
        .admin-shell {
          width: min(560px, calc(100% - 24px));
          max-width: calc(100vw - 24px);
          padding-top: 14px;
        }

        .admin-header {
          align-items: flex-start;
          flex-direction: column;
        }

        .admin-grid {
          grid-template-columns: 1fr;
        }

        .admin-tabs {
          display: flex;
          overflow-x: auto;
          padding-bottom: 4px;
        }

        .admin-tabs button {
          flex: 0 0 auto;
          white-space: nowrap;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .batch-preview {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    </style>
    <style is:global>
      .category-manager {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
        gap: 10px;
        margin: 12px 0 16px;
      }

      .category-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
        gap: 7px;
        min-width: 0;
        padding: 8px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--paper);
      }

      .category-cover-editor {
        display: grid;
        gap: 6px;
        min-width: 0;
      }

      .category-cover-editor img {
        display: block;
        width: 100%;
        height: 104px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--accent-soft);
        object-fit: cover;
      }

      .category-cover-editor input[type="file"] {
        width: 100%;
        min-width: 0;
        min-height: 32px;
        padding: 4px;
        overflow: hidden;
        font-size: 10px;
      }

      .category-cover-editor input[type="file"]::file-selector-button {
        min-height: 24px;
        margin-right: 5px;
        padding: 2px 6px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
        font-size: 10px;
      }

      .category-fields {
        display: grid;
        gap: 6px;
        min-width: 0;
      }

      .category-row input:not([type="file"]),
      .category-row select {
        width: 100%;
        min-width: 0;
        min-height: 32px;
        padding: 5px 7px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
        color: var(--ink);
        font: inherit;
        font-size: 12px;
        line-height: 1.3;
      }

      .category-row button {
        min-height: 30px;
        padding: 4px 7px;
        border: 1px solid var(--accent-soft);
        border-radius: 8px;
        background: var(--accent-hover);
        color: var(--accent-strong);
        cursor: pointer;
        font-size: 11px;
        font-weight: 800;
      }

      @media (max-width: 560px) {
        .category-manager {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }

        .category-cover-editor img {
          height: 92px;
        }
      }

      .story-manager {
        display: grid;
        gap: 8px;
        margin-top: 12px;
      }

      .story-edit-card {
        display: grid;
        gap: 8px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: #fff;
      }

      .story-edit-card summary {
        cursor: pointer;
        font-weight: 850;
      }

      .story-image-preview,
      .story-row-images {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
        gap: 6px;
      }

      .story-image-preview img,
      .story-row-images img {
        width: 100%;
        height: 58px;
        border: 1px solid var(--line);
        border-radius: 8px;
        object-fit: cover;
      }

      .story-row {
        display: grid;
        grid-template-columns: minmax(86px, 0.8fr) minmax(0, 1.2fr) 58px;
        gap: 8px;
        align-items: center;
      }

      .story-row.is-edit {
        grid-template-columns: minmax(0, 1fr);
      }

      .story-row input,
      .story-row textarea {
        min-height: 38px;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: #fff;
        color: var(--ink);
        font: inherit;
      }

      .story-row textarea {
        min-height: 92px;
        resize: vertical;
      }

      .story-row button {
        min-height: 38px;
        padding: 0 8px;
        border: 1px solid var(--accent-soft);
        border-radius: 8px;
        background: var(--accent-hover);
        color: var(--accent-strong);
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      .story-row-image {
        display: grid;
        gap: 3px;
      }

      .story-row-image button {
        min-height: 26px;
        font-size: 10px;
      }

      .batch-preview {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(86px, 1fr)) !important;
        gap: 8px !important;
        overflow: hidden;
      }

      .batch-preview figure {
        display: grid !important;
        min-width: 0;
        max-width: 100%;
        gap: 3px;
        margin: 0;
        padding: 5px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
      }

      .batch-preview img {
        display: block;
        width: 100%;
        max-width: 100%;
        height: 62px;
        object-fit: cover;
        border-radius: 8px;
      }

      .batch-preview figcaption {
        font-size: 10px;
      }

      .gallery-count-summary {
        margin: 12px 0 6px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
      }

      .batch-preview-meta {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 3px;
      }

      .batch-category-badge,
      .batch-source-badge {
        overflow: hidden;
        padding: 2px 4px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 800;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .batch-category-badge {
        min-width: 0;
        background: var(--accent-soft);
        color: var(--accent-strong);
      }

      .batch-source-badge {
        flex: 0 0 auto;
        background: var(--site-bg-soft);
        color: var(--muted);
      }

      .batch-source-badge.is-cloud {
        background: var(--accent);
        color: var(--button-text);
      }

      .batch-preview figure.is-readonly {
        cursor: default;
      }

      .batch-preview-controls {
        display: none !important;
        min-width: 0;
        gap: 3px;
      }

      .batch-preview figure.is-editing {
        grid-column: span 2;
        cursor: default;
        box-shadow: 0 0 0 2px var(--accent-soft);
      }

      .batch-preview figure.is-editing .batch-preview-controls {
        display: grid !important;
      }

      .batch-preview-controls input,
      .batch-preview-controls select {
        width: 100% !important;
        max-width: 100%;
        box-sizing: border-box;
        min-height: 26px;
        padding: 4px 5px;
        font-size: 10px;
      }

      .batch-preview-controls .small-danger {
        width: 100%;
        min-height: 26px;
        padding: 0 5px;
        font-size: 10px;
        white-space: nowrap;
      }

      @media (max-width: 430px) {
        .batch-preview {
          grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
          gap: 6px !important;
        }

        .batch-preview img { height: 54px; }

        .story-row {
          grid-template-columns: minmax(0, 1fr) 58px;
        }

        .story-row input[type="date"] {
          grid-column: 1 / -1;
        }

        .story-row-images {
          grid-column: 1 / -1;
        }
      }
    </style>
  </head>
  <body>
    <div class="admin-bootstrap" data-admin-bootstrap role="status" aria-live="polite">
      <div class="admin-bootstrap-card">
        <span class="admin-bootstrap-spinner" aria-hidden="true"></span>
        <strong data-admin-bootstrap-title>正在准备管理后台…</strong>
        <p data-admin-bootstrap-message>正在确认登录状态和站点数据。</p>
        <button type="button" data-admin-bootstrap-retry hidden>重新加载</button>
      </div>
    </div>
    <div class="login-wrap" data-login>
      <section class="login-card">
        <h1>进入后台</h1>
        <p>登录后可以编辑网站资料、故事和相册内容。</p>
        <form data-login-form>
          <label class="field">
            后台密码
            <input type="password" name="password" inputmode="numeric" autocomplete="current-password" placeholder="请输入后台密码" />
          </label>
          <button class="primary-button" type="submit">进入</button>
          <p class="hint">请使用为你分配的后台密码登录。</p>
        </form>
      </section>
    </div>

    <main class="admin-shell" data-admin hidden>
      <header class="admin-header">
        <div>
          <h1>网站管理后台</h1>
          <p>编辑内容后保存，前台网站会同步更新。</p>
        </div>
        <div class="header-actions">
          <a class="ghost-link" href="/">看首页</a>
          <button class="ghost-button" type="button" data-logout>退出</button>
        </div>
      </header>

      <div class="admin-grid">
        <nav class="admin-tabs" aria-label="后台模块">
          <button type="button" aria-selected="true" data-tab="profile">首页资料</button>
          <button type="button" aria-selected="false" data-tab="about">关于我们</button>
          <button type="button" aria-selected="false" data-tab="stories">我们的故事</button>
          <button type="button" aria-selected="false" data-tab="modules">模块标题</button>
          <button type="button" aria-selected="false" data-tab="music">音乐</button>
          <button type="button" aria-selected="false" data-tab="quotes">想对你说</button>
          <button type="button" aria-selected="false" data-tab="anniversaries">纪念日</button>
          <button type="button" aria-selected="false" data-tab="gallery">图片管理</button>
        </nav>

        <form class="admin-form" data-admin-form>
          <section class="admin-card is-active" data-panel="profile">
            <h2>首页资料</h2>
            <div class="form-row">
              <label class="field">
                网站昵称
                <input name={editableTitlePaths.site} />
              </label>
              <label class="field">
                角色名或关系提示
                <input name="profile.roleName" />
              </label>
            </div>
            <label class="field">
              主题色
              <select name="profile.themeColor">
                {themeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </label>
            <section class="theme-customizer" aria-labelledby="custom-theme-title">
              <div>
                <h3 id="custom-theme-title">自定义主题色</h3>
                <p class="hint">用调色盘选择一个主色，页面背景、卡片、按钮、边框和文字会自动搭配。</p>
              </div>
              <div class="theme-inputs">
                <label class="field color-picker-field">
                  调色盘
                  <input type="color" data-custom-theme-picker value="#B98231" />
                </label>
                <label class="field">
                  Hex（可选）
                  <input data-custom-theme-hex inputmode="text" autocomplete="off" maxlength="7" placeholder="#9AFF9A 或 9AFF9A" />
                </label>
              </div>
              <p class="theme-error" data-custom-theme-error aria-live="polite"></p>
              <div class="theme-preview" data-theme-preview>
                <div>
                  <strong>实时预览</strong>
                  <p class="hint">浅背景、正文和按钮文字会自动保证清晰可读。</p>
                </div>
                <span class="theme-preview-swatch">按钮示例</span>
              </div>
              <div class="theme-actions">
                <button class="ghost-button" type="button" data-restore-preset-theme>恢复预设主题</button>
                <button class="ghost-button" type="button" data-cancel-theme-change>取消未保存修改</button>
              </div>
            </section>
            <label class="field">
              页面布局
              <select name="profile.layoutPreset">
                <option value="full">完整侧栏</option>
                <option value="compact">精简侧栏</option>
                <option value="none">无侧栏（模块移到主内容下方）</option>
              </select>
              <span class="hint">无侧栏时主内容会在限制宽度内居中，不会铺满整个屏幕。</span>
            </label>
            <label class="field">
              首页简介
              <textarea name="profile.intro"></textarea>
            </label>
            <div class="switch-list">
              <label class="switch-row">
                <span>显示关于我们</span>
                <input type="checkbox" name="profile.showAbout" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示我们的故事</span>
                <input type="checkbox" name="profile.showStory" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示音乐</span>
                <input type="checkbox" name="profile.showMusic" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示想对你说</span>
                <input type="checkbox" name="profile.showQuotes" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示纪念日</span>
                <input type="checkbox" name="profile.showAnniversaryList" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示日历</span>
                <input type="checkbox" name="profile.showCalendar" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示周边与相册</span>
                <input type="checkbox" name="profile.showGoodsWall" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示管理入口</span>
                <input type="checkbox" name="profile.showAdminEntry" data-boolean-field />
              </label>
            </div>
            <p class="module-guidance">
              不需要的模块可以关闭。关闭只影响前台展示，不会自动删除已经保存的故事、图片、语录或纪念日内容。
            </p>
            <div class="form-row">
              <label class="image-preview-field">
                头像图片
                <span class="hint">手机上点这里可以从相册选图，先看上传手感。</span>
                <span class="image-preview"><img data-preview="profile.avatar" alt="" /></span>
                <input type="file" accept="image/*,.heic,.heif" data-image-input="profile.avatar" />
              </label>
              <label class="image-preview-field">
                首页背景图
                <span class="hint">建议横图，可以调显示位置和大小。</span>
                <span class="image-preview is-wide"><img data-preview="profile.cover" alt="" /></span>
                <input type="file" accept="image/*,.heic,.heif" data-image-input="profile.cover" />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                背景显示位置
                <select name="profile.coverPosition">
                  <option value="center center">居中</option>
                  <option value="center top">偏上</option>
                  <option value="center bottom">偏下</option>
                  <option value="left center">偏左</option>
                  <option value="right center">偏右</option>
                </select>
              </label>
              <label class="field">
                背景大小比例
                <select name="profile.coverScale">
                  <option value="">自动铺满</option>
                  <option value="100">100%</option>
                  <option value="115">115%</option>
                  <option value="130">130%</option>
                  <option value="150">150%</option>
                  <option value="170">170%</option>
                </select>
              </label>
            </div>
            <div class="form-row">
              <label class="image-preview-field">
                轮播背景图
                <span class="hint">可以一次选多张，首页头图会自动轮流换。</span>
                <input type="file" accept="image/*,.heic,.heif" multiple data-cover-batch-input />
              </label>
              <label class="field">
                轮播间隔秒数
                <input name="profile.coverInterval" type="number" min="3" max="30" placeholder="6" />
              </label>
            </div>
            <button class="ghost-button" type="button" data-clear-covers>清空轮播背景图</button>
            <div class="batch-preview" data-cover-preview></div>
          </section>

          <section class="admin-card" data-panel="about">
            <h2>关于我们</h2>
            <label class="field">
              故事引言
              <textarea name="about.storyIntro"></textarea>
            </label>
            <div class="form-row">
              <label class="field">
                左边称呼
                <input name="about.personAName" />
              </label>
              <label class="field">
                右边称呼
                <input name="about.personBName" />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                左边简介
                <textarea name="about.personABio"></textarea>
              </label>
              <label class="field">
                右边简介
                <textarea name="about.personBBio"></textarea>
              </label>
            </div>
            <div class="form-row">
              <label class="image-preview-field">
                左边头像
                <span class="image-preview"><img data-preview="about.personAAvatar" alt="" /></span>
                <input type="file" accept="image/*,.heic,.heif" data-image-input="about.personAAvatar" />
              </label>
              <label class="image-preview-field">
                右边头像
                <span class="image-preview"><img data-preview="about.personBAvatar" alt="" /></span>
                <input type="file" accept="image/*,.heic,.heif" data-image-input="about.personBAvatar" />
              </label>
            </div>
          </section>

          <section class="admin-card" data-panel="stories">
            <h2>我们的故事</h2>
            <p class="hint">新增或编辑故事后，首页时间线会同步更新。</p>
            <label class="switch-row">
              <span>显示这个模块</span>
              <input type="checkbox" name="profile.showStory" data-boolean-field />
            </label>
            <div class="form-row">
              <label class="field">
                故事日期
                <input type="date" data-story-date />
              </label>
              <label class="field">
                故事标题
                <input data-story-title placeholder="例如：第一次一起看烟花" />
              </label>
            </div>
            <label class="field">
              故事简介
              <textarea data-story-summary placeholder="可选，写一句首页列表或以后详情页会用到的话。"></textarea>
            </label>
            <label class="field">
              故事正文
              <textarea data-story-body placeholder="正文可以写多段，保存后点首页新增的故事可以查看。"></textarea>
            </label>
            <label class="image-preview-field">
              故事配图
              <span class="hint">可以一次选择多张；优先保留原图清晰度，超大文件会自动安全压缩。</span>
              <input type="file" accept="image/*,.heic,.heif" multiple data-story-images />
            </label>
            <div class="story-image-preview" data-story-image-preview></div>
            <button class="ghost-button" type="button" data-add-story>添加到故事列表</button>
            <div class="story-manager" data-story-manager></div>
          </section>

          <section class="admin-card" data-panel="modules">
            <h2>模块标题</h2>
            <div class="form-row">
              <label class="field">
                关于我们标题
                <input name={editableTitlePaths.about} />
              </label>
              <label class="field">
                我们的故事标题
                <input name={editableTitlePaths.story} />
              </label>
              <label class="field">
                周边与相册标题
                <input name={editableTitlePaths.gallery} />
              </label>
              <label class="field">
                管理入口标题
                <input name={editableTitlePaths.admin} />
              </label>
              <label class="field">
                相册页标题
                <input name={editableTitlePaths.albumPage} />
              </label>
              <label class="field">
                想对你说标题
                <input name={editableTitlePaths.quote} />
              </label>
              <label class="field">
                纪念日标题
                <input name={editableTitlePaths.anniversary} />
              </label>
              <label class="field">
                日历标题
                <input name={editableTitlePaths.calendar} />
              </label>
            </div>
          </section>

          <section class="admin-card" data-panel="music">
            <h2>音乐模块</h2>
            <p class="hint">网易云歌曲分享链接里一般带有 id，直接粘贴整条链接就行；也可以填网易云歌曲 ID、QQ 音乐链接，或者能直接播放的音频链接。</p>
            <label class="switch-row">
              <span>显示这个模块</span>
              <input type="checkbox" name="profile.showMusic" data-boolean-field />
            </label>
            <div class="form-row">
              <label class="field">
                模块标题
                <input name={editableTitlePaths.music} placeholder="例如：音乐" />
              </label>
              <label class="field">
                音乐链接或歌曲 ID
                <input name="profile.musicUrl" placeholder="例如：https://music.163.com/song?id=xxxx" />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                歌曲名
                <input name="profile.musicTitle" placeholder="例如：写给你的一首歌" />
              </label>
              <label class="field">
                歌手/备注
                <input name="profile.musicArtist" placeholder="例如：歌手名 / 想写的话" />
              </label>
            </div>
            <label class="image-preview-field">
              音乐封面
              <span class="hint">会显示在音乐卡片左边，不填时默认使用首页头像。</span>
              <span class="image-preview"><img data-preview="profile.musicCover" alt="" /></span>
              <input type="file" accept="image/*,.heic,.heif" data-image-input="profile.musicCover" />
            </label>
            <p class="hint">手机浏览器通常不允许自动播放，访客需要自己点一下播放。QQ 音乐有些歌曲不开放网页直放，播不了时换网易云链接更稳。</p>
          </section>

          <section class="admin-card" data-panel="quotes">
            <h2>想对你说</h2>
            <p class="hint">可以写多句话，前台会随机展示其中一句。</p>
            <label class="switch-row">
              <span>显示这个模块</span>
              <input type="checkbox" name="profile.showQuotes" data-boolean-field />
            </label>
            <div class="form-row">
              <label class="field">
                按钮文案
                <input name="profile.quoteButtonText" placeholder="例如：换一句" />
              </label>
              <label class="field">
                没有语录时的默认文案
                <input name="profile.quoteFallback" />
              </label>
            </div>
            <label class="field">
              新增一句话
              <textarea data-quote-content placeholder="写一句想对 TA 说的话"></textarea>
            </label>
            <label class="field">
              标签/心情
              <input data-quote-mood placeholder="例如：温柔、日常、甜甜的" />
            </label>
            <button class="ghost-button" type="button" data-add-quote>添加到语录列表</button>
            <div class="quote-manager" data-quote-manager></div>
          </section>

          <section class="admin-card" data-panel="anniversaries">
            <h2>纪念日与日历</h2>
            <p class="hint">添加纪念日后，前台会显示第几天；勾选日历标记后，也会出现在小日历里。</p>
            <div class="switch-list">
              <label class="switch-row">
                <span>显示纪念日模块</span>
                <input type="checkbox" name="profile.showAnniversaryList" data-boolean-field />
              </label>
              <label class="switch-row">
                <span>显示日历模块</span>
                <input type="checkbox" name="profile.showCalendar" data-boolean-field />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                纪念日名称
                <input data-anniversary-title placeholder="例如：喜欢上你的那一天" />
              </label>
              <label class="field">
                日期
                <input type="date" data-anniversary-date />
              </label>
            </div>
            <label class="switch-row">
              <span>在日历上标记这一天</span>
              <input type="checkbox" data-anniversary-show-calendar checked />
            </label>
            <div class="form-row">
              <label class="field">
                日历短标记
                <input data-anniversary-calendar-text placeholder="例如：相遇" />
              </label>
              <label class="field">
                备注
                <input data-anniversary-note placeholder="可选，显示在日历详情里" />
              </label>
            </div>
            <button class="ghost-button" type="button" data-add-anniversary>添加到纪念日列表</button>
            <div class="anniversary-manager" data-anniversary-manager></div>
          </section>

          <section class="admin-card" data-panel="gallery">
            <h2>图片管理</h2>
            <p class="hint">相册分类可以新增、改名、排序和删除。分类为 0 时前台不会显示整个相册模块，也不会留下空白。</p>
            <p class="module-guidance">删除有图片的分类会要求二次确认；分类图片不会被静默删除，而会保留在图片管理中并标记为“未分类”。</p>
            <div class="category-manager" data-category-manager></div>
            <div class="category-actions">
              <button class="ghost-button" type="button" data-add-category>新增分类</button>
            </div>
            <div class="form-row">
              <label class="field">
                图片分类
                <select data-batch-category></select>
              </label>
              <label class="field">
                这一批图片标题
                <input data-batch-title placeholder="例如：生日谷、约会照片" />
              </label>
            </div>
            <label class="field">
              这一批图片说明
              <textarea data-batch-caption placeholder="可选，写给自己看的备注。"></textarea>
            </label>
            <label class="image-preview-field">
              批量选择图片
              <span class="hint">可以一次选择多张图片；优先保留原图清晰度，超大文件会自动安全压缩，前台大图可继续打开原图查看。</span>
              <input type="file" accept="image/*,.heic,.heif" multiple data-batch-input />
            </label>
            <p class="hint" data-batch-upload-status role="status" aria-live="polite">等待选择图片</p>
            <button class="ghost-button" type="button" data-clear-batch>清空云端上传列表</button>
            <p class="gallery-count-summary" data-gallery-count-summary></p>
            <div class="batch-preview" data-batch-preview></div>
          </section>

          <div class="save-bar" data-save-bar>
            <button class="ghost-button" type="button" data-preview-home>保存并预览首页</button>
            <button class="primary-button" type="submit">保存到云端</button>
          </div>
        </form>
      </div>
    </main>

    <div class="toast" data-toast hidden></div>
    <script id="initial-admin-data" type="application/json" set:html={JSON.stringify(initialData)} is:inline></script>
    <script id="admin-theme-map" type="application/json" set:html={JSON.stringify(themeMap)} is:inline></script>
    <script id="admin-config" type="application/json" set:html={JSON.stringify({ customerId, pagesProjectName })} is:inline></script>
    <script>
      // @ts-nocheck -- 这是已有的后台客户端脚本；由浏览器回归与生产构建验证。
      const configNode = document.querySelector("#admin-config");
      const adminConfig = configNode?.textContent ? JSON.parse(configNode.textContent) : {};
      const cloudEndpoint = "/api/admin-data";
      const storagePrefix = `dream-admin-${adminConfig.customerId || "demo"}`;
      const storageKey = `${storagePrefix}-data`;
      const loginKey = `${storagePrefix}-login`;
      const passwordKey = `${storagePrefix}-password`;
      const initialNode = document.querySelector("#initial-admin-data");
      const initial = initialNode?.textContent ? JSON.parse(initialNode.textContent) : {};
      const saved = localStorage.getItem(storageKey);
      const savedData = saved ? JSON.parse(saved) : null;
      let state;
      const defaultStoryItems = Array.isArray(initial.defaultStoryItems) ? initial.defaultStoryItems : [];
      const defaultQuoteItems = Array.isArray(initial.defaultQuoteItems) ? initial.defaultQuoteItems : [];
      const defaultAnniversaryItems = Array.isArray(initial.defaultAnniversaryItems) ? initial.defaultAnniversaryItems : [];
      const defaultGalleryCategories = Array.isArray(initial.galleryCategories) ? initial.galleryCategories : [];
      const defaultGalleryItems = Array.isArray(initial.defaultGalleryItems) ? initial.defaultGalleryItems : [];

      function normalizeGalleryDraft(value) {
        const source = typeof value === "string"
          ? { images: value }
          : value && typeof value === "object" && !Array.isArray(value) ? { ...value } : {};
        const images = [];
        const appendCandidate = (item) => {
          if (typeof item === "string" && item.trim()) {
            images.push({ image: item.trim() });
            return;
          }
          if (item && typeof item === "object" && !Array.isArray(item) && typeof item.image === "string" && item.image.trim()) {
            images.push({ ...item, image: item.image.trim() });
          }
        };
        if (Array.isArray(source.images)) source.images.forEach(appendCandidate);
        else appendCandidate(source.images);
        if (Array.isArray(source.items)) source.items.forEach(appendCandidate);
        else appendCandidate(source.items);
        if (!images.some((item) => item.image === source.image)) appendCandidate(source.image);
        return { ...source, images };
      }

      function mergeStateWithDefaults(value) {
        const source = value && typeof value === "object" && !Array.isArray(value) ? value : {};
        const merged = {
          ...initial,
          ...source,
          profile: { layoutPreset: "full", customThemeColor: "", ...(initial.profile || {}), ...(source.profile || {}) },
          about: { ...(initial.about || {}), ...(source.about || {}) },
          modules: { ...(initial.modules || {}), ...(source.modules || {}) },
          galleryCategories: Object.prototype.hasOwnProperty.call(source, "galleryCategories") && Array.isArray(source.galleryCategories)
            ? source.galleryCategories
            : initial.galleryCategories,
          storyDraft: source.storyDraft || initial.storyDraft || { items: [], deletedStoryIds: [] },
          quotesDraft: source.quotesDraft || initial.quotesDraft || { items: [], deletedQuoteIds: [] },
          anniversaryDraft: source.anniversaryDraft || initial.anniversaryDraft || { items: [], deletedAnniversaryIds: [] },
          galleryDraft: normalizeGalleryDraft(source.galleryDraft || initial.galleryDraft),
        };
        delete merged.defaultGalleryItems;
        delete merged.defaultStoryItems;
        delete merged.defaultQuoteItems;
        delete merged.defaultAnniversaryItems;
        return merged;
      }

      state = mergeStateWithDefaults(savedData);
      const login = document.querySelector("[data-login]");
      const admin = document.querySelector("[data-admin]");
      const toast = document.querySelector("[data-toast]");
      let storyPendingImages = [];
      const adminThemeMap = JSON.parse(document.querySelector("#admin-theme-map")?.textContent || "{}");
      let savedThemeSnapshot = null;
      let cloudLoadPromise = Promise.resolve(true);
      let cloudSaveQueue = Promise.resolve();
      let cloudLoadFailure = "";

      function setAdminInitState(value, message = "") {
        document.documentElement.dataset.adminInit = value;
        const title = document.querySelector("[data-admin-bootstrap-title]");
        const detail = document.querySelector("[data-admin-bootstrap-message]");
        const retry = document.querySelector("[data-admin-bootstrap-retry]");
        if (value === "error") {
          if (title) title.textContent = "暂时无法加载后台";
          if (detail) detail.textContent = message || "请检查网络后重试。";
          if (retry) retry.hidden = false;
        } else if (retry) {
          retry.hidden = true;
        }
      }

      function revealInitializedAdmin() {
        requestAnimationFrame(() => requestAnimationFrame(() => setAdminInitState("ready")));
      }

      function normalizeKey(value) {
        return String(value || "")
          .trim()
          .toLowerCase()
          .replace(/[^a-z0-9_-]+/g, "-")
          .replace(/^-+|-+$/g, "");
      }

      function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, (char) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[char]);
      }

      function getGalleryCategories() {
        const source = Array.isArray(state.galleryCategories) ? state.galleryCategories : defaultGalleryCategories;
        return source
          .map((category, index) => ({
            key: normalizeKey(category.key) || `category-${index + 1}`,
            title: String(category.title || "").trim() || `分类 ${index + 1}`,
            cover: String(category.cover || ""),
            coverPosition: ["center", "top", "bottom", "left", "right"].includes(category.coverPosition) ? category.coverPosition : "center",
            order: Number(category.order ?? index + 1),
          }))
          .sort((a, b) => a.order - b.order);
      }

      function ensureGalleryCategories() {
        state.galleryCategories = getGalleryCategories();
        return state.galleryCategories;
      }

      function buildCategoryOptions(selectedKey = "") {
        const categories = getGalleryCategories();
        const options = categories
          .map((category) => {
            const selected = category.key === selectedKey ? " selected" : "";
            return `<option value="${escapeHtml(category.key)}" data-label="${escapeHtml(category.title)}"${selected}>${escapeHtml(category.title)}</option>`;
          })
          .join("");
        const uncategorizedSelected = !selectedKey || !categories.some((category) => category.key === selectedKey) ? " selected" : "";
        return `<option value="" data-label="未分类"${uncategorizedSelected}>未分类（前台不显示）</option>${options}`;
      }

      function getPath(path) {
        return path.split(".").reduce((value, key) => value?.[key], state) ?? "";
      }

      function setPath(path, value) {
        const keys = path.split(".");
        let target = state;
        for (const key of keys.slice(0, -1)) {
          target[key] ??= {};
          target = target[key];
        }
        target[keys[keys.length - 1]] = value;
      }

      function showToast(message) {
        if (!toast) return;
        toast.textContent = message;
        toast.hidden = false;
        window.setTimeout(() => {
          toast.hidden = true;
        }, 2200);
      }

      function setBatchUploadStatus(message) {
        const status = document.querySelector("[data-batch-upload-status]");
        if (status) status.textContent = message;
      }

      function setBatchUploadBusy(busy) {
        const form = document.querySelector("[data-admin-form]");
        if (form) form.setAttribute("aria-busy", String(busy));
        document.querySelectorAll('[data-batch-input], [data-clear-batch], [data-batch-category], [data-batch-title], [data-batch-caption], [data-admin-form] button[type="submit"], [data-preview-home]').forEach((control) => {
          control.disabled = busy;
        });
      }

      function showAdmin() {
        login.hidden = true;
        admin.hidden = false;
      }

      function applyAdminTheme() {
        const theme = window.DreamTheme?.resolveTheme(state.profile, adminThemeMap)
          || adminThemeMap[state.profile?.themeColor]
          || adminThemeMap.lavender;
        window.DreamTheme?.applyThemeVars(theme, [document.documentElement]);
        const preview = document.querySelector("[data-theme-preview]");
        if (preview) preview.setAttribute("data-custom-active", String(Boolean(state.profile?.customThemeColor)));
      }

      function rememberSavedTheme() {
        savedThemeSnapshot = {
          themeColor: state.profile?.themeColor || "gold",
          customThemeColor: window.DreamTheme?.normalizeHex(state.profile?.customThemeColor) || "",
        };
      }

      function syncThemeControls() {
        const normalized = window.DreamTheme?.normalizeHex(state.profile?.customThemeColor) || "";
        const preset = adminThemeMap[state.profile?.themeColor] || adminThemeMap.gold || adminThemeMap.lavender;
        const picker = document.querySelector("[data-custom-theme-picker]");
        const hex = document.querySelector("[data-custom-theme-hex]");
        const error = document.querySelector("[data-custom-theme-error]");
        if (picker) picker.value = normalized || preset?.accent || "#B98231";
        if (hex) hex.value = normalized;
        if (error) error.textContent = "";
        applyAdminTheme();
      }

      function getCategoryCoverPreview(category) {
        if (category.cover) return category.cover;
        const matchesCategory = (item) =>
          item.categoryKey === category.key ||
          (!item.categoryKey && item.category === category.title);
        const builtInImage = defaultGalleryItems.find(matchesCategory)?.image;
        const cloudImage = (state.galleryDraft?.images ?? []).find(matchesCategory)?.image;
        return builtInImage || cloudImage || "/uploads/memory-placeholder.svg";
      }

      function renderCategoryControls() {
        ensureGalleryCategories();
        const manager = document.querySelector("[data-category-manager]");
        if (manager) {
          manager.textContent = "";
          if (state.galleryCategories.length === 0) {
            const empty = document.createElement("p");
            empty.className = "hint";
            empty.textContent = "当前没有相册分类，前台相册模块不会渲染。点击“新增分类”即可恢复。";
            manager.append(empty);
          }
          for (const [index, category] of state.galleryCategories.entries()) {
            const row = document.createElement("div");
            const coverEditor = document.createElement("div");
            const coverPreview = document.createElement("img");
            const coverInput = document.createElement("input");
            const fields = document.createElement("div");
            const input = document.createElement("input");
            const position = document.createElement("select");
            const clearCover = document.createElement("button");
            const orderActions = document.createElement("div");
            const moveUp = document.createElement("button");
            const moveDown = document.createElement("button");
            const remove = document.createElement("button");
            row.className = "category-row";
            coverEditor.className = "category-cover-editor";
            coverPreview.src = getCategoryCoverPreview(category);
            coverPreview.alt = `${category.title}分类封面预览`;
            coverPreview.loading = "eager";
            coverPreview.decoding = "async";
            coverPreview.style.objectPosition = category.cover ? category.coverPosition : "center";
            coverPreview.addEventListener("error", () => {
              if (!coverPreview.src.endsWith("/uploads/memory-placeholder.svg")) {
                coverPreview.src = "/uploads/memory-placeholder.svg";
              }
            });
            coverPreview.setAttribute("data-category-cover-preview", String(index));
            coverInput.type = "file";
            coverInput.accept = "image/*,.heic,.heif";
            coverInput.setAttribute("data-category-cover-input", String(index));
            coverEditor.append(coverPreview, coverInput);
            fields.className = "category-fields";
            input.type = "text";
            input.value = category.title;
            input.placeholder = "分类名称";
            input.setAttribute("data-category-title", String(index));
            for (const [value, label] of [["center", "封面居中"], ["top", "封面偏上"], ["bottom", "封面偏下"], ["left", "封面偏左"], ["right", "封面偏右"]]) {
              const option = document.createElement("option");
              option.value = value;
              option.textContent = label;
              option.selected = category.coverPosition === value;
              position.append(option);
            }
            position.setAttribute("data-category-cover-position", String(index));
            clearCover.className = "small-danger";
            clearCover.type = "button";
            clearCover.textContent = "清除自定义封面";
            clearCover.setAttribute("data-clear-category-cover", String(index));
            orderActions.className = "category-order-actions";
            moveUp.className = "ghost-button";
            moveUp.type = "button";
            moveUp.textContent = "上移";
            moveUp.disabled = index === 0;
            moveUp.setAttribute("data-move-category", "up");
            moveUp.setAttribute("data-index", String(index));
            moveDown.className = "ghost-button";
            moveDown.type = "button";
            moveDown.textContent = "下移";
            moveDown.disabled = index === state.galleryCategories.length - 1;
            moveDown.setAttribute("data-move-category", "down");
            moveDown.setAttribute("data-index", String(index));
            orderActions.append(moveUp, moveDown);
            fields.append(input, position, clearCover, orderActions);
            remove.className = "small-danger";
            remove.type = "button";
            remove.textContent = "删除";
            remove.setAttribute("data-remove-category", String(index));
            row.append(coverEditor, fields, remove);
            manager.append(row);
          }
        }

        renderCategorySelects();
      }

      function renderCategorySelects() {
        document.querySelectorAll("[data-batch-category]").forEach((select) => {
          const current = select.value || getGalleryCategories()[0]?.key || "goods";
          select.innerHTML = buildCategoryOptions(current);
        });
      }

      function getStoryItems() {
        state.storyDraft ??= { items: [], deletedStoryIds: [] };
        state.storyDraft.items ??= [];
        state.storyDraft.deletedStoryIds ??= [];
        const deletedKeys = new Set(state.storyDraft.deletedStoryIds);
        const existingKeys = new Set(state.storyDraft.items.map((item) => item.sourceId || item.id));
        for (const item of defaultStoryItems) {
          const key = item.sourceId || item.id;
          if (!deletedKeys.has(key) && !existingKeys.has(key)) {
            state.storyDraft.items.push({ ...item });
          }
        }
        return state.storyDraft.items;
      }

      function renderStoryManager() {
        const manager = document.querySelector("[data-story-manager]");
        if (!manager) return;
        manager.textContent = "";
        const stories = getStoryItems()
          .map((item, index) => ({ item, index }))
          .sort((a, b) => String(b.item.date || "").localeCompare(String(a.item.date || "")));
        if (stories.length === 0) {
          const empty = document.createElement("p");
          empty.className = "hint";
          empty.textContent = "还没有从后台新增故事。";
          manager.append(empty);
          return;
        }

        for (const entry of stories) {
          const { item, index } = entry;
          const card = document.createElement("details");
          const summary = document.createElement("summary");
          const row = document.createElement("div");
          const date = document.createElement("input");
          const title = document.createElement("input");
          const intro = document.createElement("textarea");
          const body = document.createElement("textarea");
          const addImages = document.createElement("input");
          const remove = document.createElement("button");
          card.className = "story-edit-card";
          summary.textContent = `${item.date || "未定日期"} · ${item.title || "未命名故事"}`;
          row.className = "story-row is-edit";
          date.type = "date";
          date.value = item.date || "";
          date.setAttribute("data-story-edit", "date");
          date.setAttribute("data-index", String(index));
          title.type = "text";
          title.value = item.title || "";
          title.placeholder = "故事标题";
          title.setAttribute("data-story-edit", "title");
          title.setAttribute("data-index", String(index));
          intro.value = item.summary || "";
          intro.placeholder = "故事简介";
          intro.setAttribute("data-story-edit", "summary");
          intro.setAttribute("data-index", String(index));
          body.value = item.body || "";
          body.placeholder = "故事正文";
          body.setAttribute("data-story-edit", "body");
          body.setAttribute("data-index", String(index));
          addImages.type = "file";
          addImages.accept = "image/*,.heic,.heif";
          addImages.multiple = true;
          addImages.setAttribute("data-story-image-add", String(index));
          remove.type = "button";
          remove.textContent = "删除";
          remove.setAttribute("data-remove-story", String(index));
          row.append(date, title, intro, body, addImages);
          if (Array.isArray(item.images) && item.images.length > 0) {
            const images = document.createElement("div");
            images.className = "story-row-images";
            for (const [imageIndex, src] of item.images.entries()) {
              const wrap = document.createElement("div");
              const image = document.createElement("img");
              const imageRemove = document.createElement("button");
              wrap.className = "story-row-image";
              image.src = src;
              image.alt = item.title || "故事配图";
              imageRemove.type = "button";
              imageRemove.textContent = "删图";
              imageRemove.setAttribute("data-remove-story-image", `${index}:${imageIndex}`);
              wrap.append(image, imageRemove);
              images.append(wrap);
            }
            row.append(images);
          }
          row.append(remove);
          card.append(summary, row);
          manager.append(card);
        }
      }

      function renderStoryImagePreview() {
        const preview = document.querySelector("[data-story-image-preview]");
        if (!preview) return;
        preview.textContent = "";
        for (const src of storyPendingImages) {
          const image = document.createElement("img");
          image.src = src;
          image.alt = "待添加故事配图";
          preview.append(image);
        }
      }

      function getQuoteItems() {
