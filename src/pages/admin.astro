          item.images.splice(imageIndex, 1);
          renderStoryManager();
          showToast("已删除这张配图，记得保存");
          return;
        }
        const indexValue = target?.getAttribute?.("data-remove-story");
        if (indexValue == null) return;
        const stories = getStoryItems();
        const item = stories[Number(indexValue)];
        const key = item?.sourceId || item?.id;
        if (key) {
          state.storyDraft ??= { items: [], deletedStoryIds: [] };
          state.storyDraft.deletedStoryIds ??= [];
          if (item?.sourceId && !state.storyDraft.deletedStoryIds.includes(key)) {
            state.storyDraft.deletedStoryIds.push(key);
          }
        }
        stories.splice(Number(indexValue), 1);
        renderStoryManager();
        showToast("已删除这条故事，记得保存");
      });

      document.querySelector("[data-add-quote]")?.addEventListener("click", () => {
        const contentInput = document.querySelector("[data-quote-content]");
        const moodInput = document.querySelector("[data-quote-mood]");
        const content = contentInput?.value?.trim();
        if (!content) {
          showToast("先写一句想说的话");
          return;
        }
        getQuoteItems().push({
          id: `quote-${Date.now().toString(36)}`,
          content,
          mood: moodInput?.value?.trim() || "",
          createdAt: new Date().toISOString(),
        });
        if (contentInput) contentInput.value = "";
        if (moodInput) moodInput.value = "";
        renderQuoteManager();
        showToast("已添加语录，记得保存到云端");
      });

      document.querySelector("[data-quote-manager]")?.addEventListener("input", (event) => {
        const target = event.target;
        const field = target?.getAttribute?.("data-quote-edit");
        const index = Number(target?.getAttribute?.("data-index"));
        const item = getQuoteItems()[index];
        if (!field || !item) return;
        item[field] = target.value;
      });

      document.querySelector("[data-quote-manager]")?.addEventListener("click", (event) => {
        const target = event.target;
        const indexValue = target?.getAttribute?.("data-remove-quote");
        if (indexValue == null) return;
        const quotes = getQuoteItems();
        const item = quotes[Number(indexValue)];
        const key = item?.sourceId || item?.id;
        if (key && item?.sourceId && !state.quotesDraft.deletedQuoteIds.includes(key)) {
          state.quotesDraft.deletedQuoteIds.push(key);
        }
        quotes.splice(Number(indexValue), 1);
        renderQuoteManager();
        showToast("已删除这句语录，记得保存");
      });

      document.querySelector("[data-add-anniversary]")?.addEventListener("click", () => {
        const titleInput = document.querySelector("[data-anniversary-title]");
        const dateInput = document.querySelector("[data-anniversary-date]");
        const showInput = document.querySelector("[data-anniversary-show-calendar]");
        const calendarTextInput = document.querySelector("[data-anniversary-calendar-text]");
        const noteInput = document.querySelector("[data-anniversary-note]");
        const title = titleInput?.value?.trim();
        if (!title) {
          showToast("先填纪念日名称");
          return;
        }
        if (!dateInput?.value) {
          showToast("先选择纪念日日期");
          return;
        }
        getAnniversaryItems().push({
          id: `anniversary-${Date.now().toString(36)}`,
          title,
          date: dateInput.value,
          kind: "since",
          showOnCalendar: showInput?.checked !== false,
          calendarText: calendarTextInput?.value?.trim() || "",
          note: noteInput?.value?.trim() || "",
          calendarColor: "gold",
          createdAt: new Date().toISOString(),
        });
        if (titleInput) titleInput.value = "";
        if (dateInput) dateInput.value = "";
        if (showInput) showInput.checked = true;
        if (calendarTextInput) calendarTextInput.value = "";
        if (noteInput) noteInput.value = "";
        renderAnniversaryManager();
        showToast("已添加纪念日，记得保存到云端");
      });

      document.querySelector("[data-anniversary-manager]")?.addEventListener("input", (event) => {
        const target = event.target;
        const field = target?.getAttribute?.("data-anniversary-edit");
        const index = Number(target?.getAttribute?.("data-index"));
        const item = getAnniversaryItems()[index];
        if (!field || !item || field === "showOnCalendar") return;
        item[field] = target.value;
      });

      document.querySelector("[data-anniversary-manager]")?.addEventListener("change", (event) => {
        const target = event.target;
        const field = target?.getAttribute?.("data-anniversary-edit");
        const index = Number(target?.getAttribute?.("data-index"));
        const item = getAnniversaryItems()[index];
        if (!field || !item) return;
        item[field] = field === "showOnCalendar" ? target.checked : target.value;
      });

      document.querySelector("[data-anniversary-manager]")?.addEventListener("click", (event) => {
        const target = event.target;
        const indexValue = target?.getAttribute?.("data-remove-anniversary");
        if (indexValue == null) return;
        const anniversaries = getAnniversaryItems();
        const item = anniversaries[Number(indexValue)];
        const key = item?.sourceId || item?.id;
        if (key && item?.sourceId && !state.anniversaryDraft.deletedAnniversaryIds.includes(key)) {
          state.anniversaryDraft.deletedAnniversaryIds.push(key);
        }
        anniversaries.splice(Number(indexValue), 1);
        renderAnniversaryManager();
        showToast("已删除这个纪念日，记得保存");
      });

      document.querySelectorAll("[data-image-input]").forEach((input) => {
        input.addEventListener("change", async () => {
          const file = input.files?.[0];
          const path = input.getAttribute("data-image-input");
          if (!file || !path) return;
          const preview = document.querySelector(`[data-preview="${path}"]`);
          const previousSrc = preview?.getAttribute("src") || "";
          const instantPreviewUrl = URL.createObjectURL(file);
          if (preview) preview.src = instantPreviewUrl;
          input.disabled = true;
          showToast("已显示预览，正在上传并保存...");
          try {
            const imageData = await compressImage(file);
            const imageUrl = await uploadImage(imageData, file.name);
            setPath(path, imageUrl);
            if (preview) preview.src = imageUrl;
            localStorage.setItem(storageKey, JSON.stringify(state));
            await saveCloudData();
            showToast("图片已上传并保存到云端");
          } catch (error) {
            if (preview) preview.src = previousSrc;
            showToast(error.message || "图片上传失败，请重新选择后再试");
          } finally {
            URL.revokeObjectURL(instantPreviewUrl);
            input.disabled = false;
            input.value = "";
          }
        });
      });

      document.querySelector("[data-batch-input]")?.addEventListener("change", async (event) => {
        const input = event.currentTarget;
        const files = Array.from(input.files ?? []);
        if (files.length === 0) return;
        await cloudLoadPromise;
        const categorySelect = document.querySelector("[data-batch-category]");
        const selectedOption = categorySelect?.selectedOptions?.[0];
        const fallbackCategory = getGalleryCategories()[0] || { key: "", title: "未分类" };
        const categoryKey = categorySelect?.value || fallbackCategory.key;
        const category = selectedOption?.dataset?.label || selectedOption?.textContent || fallbackCategory.title;
        const title = document.querySelector("[data-batch-title]")?.value || "";
        const caption = document.querySelector("[data-batch-caption]")?.value || "";
        const pendingImages = [];
        setBatchUploadBusy(true);
        let result;
        try {
          result = await uploadSelectedFiles(files, {
            maxSize: 6000,
            quality: 0.9,
            preserveOriginal: true,
            onUploaded(imageUrl, file) {
              pendingImages.push({
                image: imageUrl,
                fileName: file.name,
                categoryKey,
                category,
                title,
                caption,
                createdAt: new Date().toISOString(),
              });
            },
            onProgress(message) {
              setBatchUploadStatus(message);
            },
          });
          if (!result || result.successCount === 0) {
            const message = result ? getUploadSummary("没有图片需要保存", result) : "没有图片需要保存";
            setBatchUploadStatus(message);
            showToast(message);
            return;
          }
          const currentGallery = normalizeGalleryDraft(state.galleryDraft);
          state.galleryDraft = { ...currentGallery, images: [...currentGallery.images, ...pendingImages] };
          renderBatchPreview();
          localStorage.setItem(storageKey, JSON.stringify(state));
          await saveCloudData();
          const message = getUploadSummary(`已上传并保存 ${result.successCount} 张图片`, result);
          setBatchUploadStatus(message);
          showToast(message);
        } catch (error) {
          const message = getUploadErrorMessage(error, "图片已上传并显示，但列表保存失败，请点击保存重试");
          setBatchUploadStatus(message);
          showToast(message);
        } finally {
          input.value = "";
          setBatchUploadBusy(false);
        }
      });

      document.querySelector("[data-cover-batch-input]")?.addEventListener("change", async (event) => {
        const input = event.currentTarget;
        const files = Array.from(input.files ?? []);
        if (files.length === 0) return;
        state.profile ??= {};
        state.profile.covers ??= [];
        input.disabled = true;
        let result;
        try {
          result = await uploadSelectedFiles(files, {
            limit: 8,
            maxSize: 1600,
            quality: 0.84,
            onUploaded(imageUrl) {
              state.profile.covers.push(imageUrl);
              if (!state.profile.cover) {
                state.profile.cover = imageUrl;
                const preview = document.querySelector('[data-preview="profile.cover"]');
                if (preview) preview.src = imageUrl;
              }
              renderCoverPreview();
            },
          });
        } finally {
          input.disabled = false;
          input.value = "";
        }
        if (!result || result.successCount === 0) {
          if (result) showToast(getUploadSummary("没有轮播背景需要保存", result));
          return;
        }
        localStorage.setItem(storageKey, JSON.stringify(state));
        try {
          await saveCloudData();
          showToast(getUploadSummary(`已上传并保存 ${result.successCount} 张轮播背景`, result));
        } catch (error) {
          showToast(getUploadErrorMessage(error, "轮播背景已上传并显示，但列表保存失败，请点击保存重试"));
        }
      });

      document.querySelector("[data-clear-batch]")?.addEventListener("click", () => {
        state.galleryDraft = { images: [] };
        renderBatchPreview();
        showToast("已清空图片列表，保存后同步前台");
      });

      document.querySelector("[data-batch-preview]")?.addEventListener("input", (event) => {
        const target = event.target;
        const field = target?.getAttribute?.("data-gallery-edit");
        const index = Number(target?.getAttribute?.("data-index"));
        const item = state.galleryDraft?.images?.[index];
        if (!field || !item) return;
        if (field === "title" || field === "caption") {
          item[field] = target.value;
        }
      });

      document.querySelector("[data-batch-preview]")?.addEventListener("change", (event) => {
        const target = event.target;
        const field = target?.getAttribute?.("data-gallery-edit");
        const index = Number(target?.getAttribute?.("data-index"));
        const item = state.galleryDraft?.images?.[index];
        if (!field || !item) return;
        if (field === "category") {
          const selected = target.selectedOptions?.[0];
          item.categoryKey = target.value;
          item.category = selected?.dataset?.label || selected?.textContent || "未分类";
          renderBatchPreview();
          showToast("已修改这张图的分类，记得保存");
        }
      });

      document.querySelector("[data-batch-preview]")?.addEventListener("click", (event) => {
        const target = event.target;
        const figure = target?.closest?.("figure");
        if (target?.tagName === "IMG" && figure?.getAttribute("data-gallery-source") === "cloud") {
          const wasEditing = figure.classList.contains("is-editing");
          document.querySelectorAll("[data-batch-preview] figure.is-editing").forEach((item) => item.classList.remove("is-editing"));
          figure.classList.toggle("is-editing", !wasEditing);
          return;
        }
        const moveDirection = target?.getAttribute?.("data-move-gallery-image");
        if (moveDirection) {
          const currentGallery = normalizeGalleryDraft(state.galleryDraft);
          const images = currentGallery.images;
          const index = Number(target.getAttribute("data-index"));
          const nextIndex = moveDirection === "up" ? index - 1 : index + 1;
          if (!images[index] || !images[nextIndex]) return;
          [images[index], images[nextIndex]] = [images[nextIndex], images[index]];
          state.galleryDraft = { ...currentGallery, images };
          renderBatchPreview();
          showToast("已调整图片顺序，记得保存");
          return;
        }
        const indexValue = target?.getAttribute?.("data-remove-gallery-image");
        if (indexValue == null) return;
        const index = Number(indexValue);
        state.galleryDraft?.images?.splice(index, 1);
        renderBatchPreview();
        showToast("已删除这张图，记得保存");
      });

      document.querySelector("[data-clear-covers]")?.addEventListener("click", () => {
        state.profile ??= {};
        state.profile.covers = [];
        renderCoverPreview();
        showToast("已清空轮播背景图，保存后同步云端");
      });

      document.querySelectorAll("[data-tab]").forEach((tab) => {
        tab.addEventListener("click", () => {
          const name = tab.getAttribute("data-tab");
          document.querySelectorAll("[data-tab]").forEach((item) => {
            item.setAttribute("aria-selected", String(item === tab));
          });
          document.querySelectorAll("[data-panel]").forEach((panel) => {
            panel.classList.toggle("is-active", panel.getAttribute("data-panel") === name);
          });
        });
      });

      document.querySelector("[data-admin-form]")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        localStorage.setItem(storageKey, JSON.stringify(state));
        try {
          await saveCloudData();
          showToast("已保存到云端");
        } catch (error) {
          showToast(error.message || "保存失败，请稍后重试");
        }
      });

      document.querySelector("[data-preview-home]")?.addEventListener("click", async () => {
        localStorage.setItem(storageKey, JSON.stringify(state));
        try {
          await saveCloudData();
          location.href = "/";
        } catch (error) {
          showToast(error.message || "保存失败，暂时不能预览");
        }
      });
    </script>
  </body>
</html>
